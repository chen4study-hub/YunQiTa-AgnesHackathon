{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agnes/agent-detail/1.5",
  "title": "Frozen Agent evidence indexed by origin hour, companion to replay 1.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "building_id",
    "main_sha256",
    "origin_metadata",
    "hours"
  ],
  "properties": {
    "schema_version": {
      "const": "1.5"
    },
    "scenario": {
      "enum": [
        "normal",
        "peak",
        "abstain"
      ]
    },
    "building_id": {
      "type": "string"
    },
    "origin_metadata": {
      "type": "object",
      "description": "Unchanged modeling constants and exact threshold metadata for backend evidence."
    },
    "main_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hours": {
      "type": "object",
      "minProperties": 24,
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^(?:[0-9]|1[0-9]|2[0-3])$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "agent",
          "runtime_evidence"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "agent": {
            "type": "object",
            "required": [
              "source",
              "explanation",
              "selected",
              "selection_reason",
              "candidates",
              "receipt"
            ],
            "properties": {
              "manual_reference": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/manual_reference_row"
                }
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "temperature_optimization": {
                      "$ref": "#/$defs/temperature_optimization"
                    }
                  }
                }
              }
            }
          },
          "runtime_evidence": {
            "type": "object",
            "description": "Original numeric source/control values, not default UI fields; retained unchanged for gate and conservation checks."
          }
        }
      }
    }
  },
  "$defs": {
    "manual_reference_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "hvac_setpoint_c",
        "storage_mode",
        "battery_kw",
        "suggested_duration_hours",
        "remaining_duration_hours",
        "segment_start",
        "segment_end",
        "prepared_upper_kw",
        "requires_confirmation",
        "reason",
        "reference_soc_before",
        "reference_soc_after"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "hvac_setpoint_c": {
          "type": "number",
          "minimum": 24,
          "maximum": 27
        },
        "storage_mode": {
          "enum": [
            "charge",
            "discharge",
            "idle"
          ]
        },
        "battery_kw": {
          "type": "number",
          "minimum": -500,
          "maximum": 500
        },
        "suggested_duration_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "remaining_duration_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "segment_start": {
          "type": "string",
          "format": "date-time"
        },
        "segment_end": {
          "type": "string",
          "format": "date-time"
        },
        "prepared_upper_kw": {
          "type": "number",
          "minimum": 0
        },
        "requires_confirmation": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "reference_soc_before": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.95
        },
        "reference_soc_after": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.95
        }
      }
    },
    "temperature_optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "applied",
        "comfort_penalty",
        "comfort_penalty_cny_per_kw_degree2",
        "precool_warming_budget_ratio",
        "scope",
        "comfort_excess_penalty_cny_per_kw_degree2",
        "precool_budget_basis",
        "setpoint_step_c"
      ],
      "properties": {
        "before": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "energy_cost_cny",
            "point_grid_peak_kw",
            "upper_grid_peak_kw"
          ],
          "properties": {
            "energy_cost_cny": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "point_grid_peak_kw": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "upper_grid_peak_kw": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "energy_cost_cny",
            "point_grid_peak_kw",
            "upper_grid_peak_kw"
          ],
          "properties": {
            "energy_cost_cny": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "point_grid_peak_kw": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "upper_grid_peak_kw": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "applied": {
          "type": "boolean"
        },
        "comfort_penalty": {
          "const": "quadratic_deviation_from_25.5"
        },
        "comfort_penalty_cny_per_kw_degree2": {
          "const": 0.015
        },
        "precool_warming_budget_ratio": {
          "const": 4.0
        },
        "scope": {
          "const": "accepted_hours"
        },
        "comfort_excess_penalty_cny_per_kw_degree2": {
          "const": 0.1
        },
        "selection_guard_passed": {
          "type": "boolean"
        },
        "selection_guard_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "energy_cost_cny",
            "point_grid_peak_kw",
            "upper_grid_peak_kw"
          ],
          "properties": {
            "energy_cost_cny": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "point_grid_peak_kw": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "upper_grid_peak_kw": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "precool_budget_basis": {
          "const": "mean_peak_warming_over_two_prepeak_hours"
        },
        "setpoint_step_c": {
          "const": 0.1
        },
        "zone_comfort_source": {
          "const": "src.ops.metrics.floor_rows"
        },
        "occupied_hours": {
          "const": "07-20 inclusive"
        },
        "occupied_zone_limit_c": {
          "const": 27.0
        },
        "comfort_corrections": {
          "type": "integer",
          "minimum": 0
        },
        "max_zone_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
