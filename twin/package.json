{
  "name": "yunqi-twin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-validators.mjs",
    "dev": "vite --host 127.0.0.1",
    "sync-replay": "node scripts/sync-replay.mjs",
    "prebuild": "node scripts/generate-validators.mjs",
    "build": "node scripts/licenses.mjs --emit && tsc --noEmit && vite build",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "test": "vitest run",
    "format": "prettier --write src tests e2e *.ts *.json index.html scripts/*.mjs",
    "format:check": "prettier --check src tests e2e *.ts *.json index.html scripts/*.mjs",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs --emit"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "echarts": "5.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.7.2",
    "vite": "8.3.4",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "5.0.3"
  }
}
