LLM_MODE=demo
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# 留空使用进程内限流；可配置共享 Redis URL（此处不提供地址或凭据）。
# Redis 不可用时退回进程内限流，仅警告一次；约每 60 秒在请求到来时尝试重连。
# 连通后同步未过期的本地增量并切回 Redis，不清空故障期间已用额度。
# 未配置/不可用时，各进程独立计数；跨进程共享额度需可用的 Redis。
RATE_LIMIT_REDIS_URL=
# /chat 与 /chat/stream 共享每 IP 额度，IP 由服务端受信代理配置确定。
# 固定分钟/Asia/Shanghai 自然日窗口，北京时间零点重置；以下 IP 额度最小为 1。
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_IP_PER_DAY=200
# 全站走真实 LLM 的问答次数每日总上限（北京时间零点重置），0 表示全走本地规则。
# 每个问题在入口只计一次，分类、多轮、工具调用及重试不再扣额度。
# 入口决定贯穿整个回答，不因其他问题耗尽额度而中途切换；公众站保持 LLM_MODE=demo。
# 超限后问答继续返回本地规则回答，不返回额度错误；变更变量需重启后端。
RATE_LIMIT_LLM_PER_DAY=2000
